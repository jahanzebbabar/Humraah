# Copy to .env.local and fill from Firebase console > Project settings > Your apps > Web app.
# Leave these empty to run in local demo mode (accounts and specialists kept in memory only).
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Humraah AI server (D:\NBS_app server.ts, which holds GEMINI_API_KEY). Leave empty for offline canned replies.
# Phone on Wi-Fi: use your PC LAN IP, e.g. http://192.168.1.20:3000. Web/emulator: http://localhost:3000
EXPO_PUBLIC_HUMRAAH_API_URL=
