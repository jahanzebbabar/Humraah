rules_version = '2';

// Humraah: account types are fixed at sign-up. Only accounts created as specialists
// can publish a listing, so the doctor directory only ever shows specialists who signed up in the app.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }

    // Private profile. `role` is chosen once at sign-up and can never be changed afterwards.
    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid)
        && request.resource.data.role in ['mother', 'specialist']
        && request.resource.data.uid == uid;
      allow update: if isOwner(uid) && request.resource.data.role == resource.data.role;
      allow delete: if false;
    }

    // Public directory listing. Written in the same batch as the user doc, so `getAfter`
    // sees the specialist role even on the very first write.
    match /specialists/{uid} {
      allow read: if signedIn();
      allow create: if isOwner(uid)
        && getAfter(/databases/$(database)/documents/users/$(uid)).data.role == 'specialist'
        && request.resource.data.uid == uid;
      allow update: if isOwner(uid)
        && get(/databases/$(database)/documents/users/$(uid)).data.role == 'specialist'
        && request.resource.data.uid == uid;
      allow delete: if isOwner(uid);
    }

    // Booking requests. A mother books a registered specialist; only the two of them can see it.
    // The doctor moves it through confirmed/declined/completed; the mother can only cancel.
    match /appointments/{id} {
      function role() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role; }
      function onlyStatus() { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']); }

      allow read: if signedIn()
        && (resource.data.motherId == request.auth.uid || resource.data.doctorId == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.motherId == request.auth.uid
        && request.resource.data.status == 'pending'
        && role() == 'mother'
        && exists(/databases/$(database)/documents/specialists/$(request.resource.data.doctorId));
      allow update: if signedIn() && onlyStatus() && (
        (resource.data.doctorId == request.auth.uid
          && request.resource.data.status in ['confirmed', 'declined', 'completed'])
        || (resource.data.motherId == request.auth.uid && request.resource.data.status == 'cancelled'));
      allow delete: if false;
    }
  }
}
